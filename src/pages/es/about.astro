---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);
---

<BaseLayout title={`Sobre mí — Darlyng Mateo`} description={t('about.who.body')}>
  <section class="section container">
    <span class="eyebrow">{t('about.label')}</span>
    <h1 class="section-title" style="margin-top: 16px;">{t('about.title')}</h1>

    <div class="about-grid" style="margin-top: 48px;">
      <div>
        <h2 class="project-title">{t('about.who.title')}</h2>
        <p class="lead" style="margin-top: 16px;">{t('about.who.body')}</p>

        <h2 class="project-title" style="margin-top: 48px;">{t('about.interests.title')}</h2>
        <p class="lead" style="margin-top: 16px;">{t('about.interests.body')}</p>
        <ul class="interest-list">
          <li>Algoritmos</li>
          <li>Ingeniería de backend</li>
          <li>Sistemas distribuidos</li>
          <li>Sistemas operativos</li>
        </ul>

        <h2 class="project-title" style="margin-top: 48px;">{t('about.heading.title')}</h2>
        <p class="lead" style="margin-top: 16px;">{t('about.heading.body')}</p>
      </div>

      <div class="about-photo" aria-label="Fotografía pendiente">
        Foto · pendiente
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { useTranslations } from '../../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t('journal.title')} — Darlyng Mateo`}
  description={t('journal.subtitle')}
>
  <section class="section container">
    <span class="eyebrow">{t('journal.label')}</span>
    <h1 class="section-title" style="margin-top: 16px;">{t('journal.title')}</h1>
    <p class="subtitle" style="margin-top: 12px;">{t('journal.subtitle')}</p>

    <div class="empty-state">
      <h2>{t('journal.empty.title')}</h2>
      <p>{t('journal.empty.body')}</p>
    </div>
  </section>
</BaseLayout>

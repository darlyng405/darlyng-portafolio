---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
import { useTranslations, localizedPath } from '../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);
---

<BaseLayout
  title={t('meta.home.title')}
  description={t('meta.home.description')}
>
  <Hero />

  <section class="section container">
    <span class="eyebrow">{t('home.work.label')}</span>
    <h2 class="section-title" style="margin-top: 16px;">{t('home.work.title')}</h2>
    <p class="lead" style="margin-top: 12px;">{t('home.work.subtitle')}</p>
    <div class="project-grid">
      {projects.map((p) => (
        <ProjectCard project={p} lang={lang} variant="compact" />
      ))}
    </div>
    <a href={localizedPath('/work', lang)} class="btn" style="margin-top: 28px;">
      {t('home.work.viewAll')} ↗
    </a>
  </section>

  <section class="section container">
    <span class="eyebrow">{t('home.about.label')}</span>
    <h2 class="section-title" style="margin-top: 16px; max-width: 20ch;">{t('home.about.title')}</h2>
    <p class="lead" style="margin-top: 16px;">{t('home.about.body')}</p>
    <a href={localizedPath('/about', lang)} class="btn" style="margin-top: 28px;">
      {t('home.about.cta')} ↗
    </a>
  </section>

  <section class="section container">
    <span class="eyebrow">{t('home.interests.label')}</span>
    <h2 class="section-title" style="margin-top: 16px;">{t('home.interests.title')}</h2>
    <ul class="interest-list">
      <li>{t('home.interests.algorithms')}</li>
      <li>{t('home.interests.backend')}</li>
      <li>{t('home.interests.distributed')}</li>
      <li>{t('home.interests.os')}</li>
    </ul>
  </section>

  <section class="section container">
    <span class="eyebrow">{t('home.journal.label')}</span>
    <h2 class="section-title" style="margin-top: 16px;">{t('home.journal.title')}</h2>
    <p class="lead" style="margin-top: 16px;">{t('home.journal.body')}</p>
    <a href={localizedPath('/journal', lang)} class="btn" style="margin-top: 28px;">
      {t('home.journal.cta')} ↗
    </a>
  </section>

  <section class="section container">
    <span class="eyebrow">{t('home.contact.label')}</span>
    <h2 class="section-title" style="margin-top: 16px;">{t('home.contact.title')}</h2>
    <p class="lead" style="margin-top: 16px;">{t('home.contact.body')}</p>
    <a href={localizedPath('/contact', lang)} class="btn primary" style="margin-top: 28px;">
      {t('home.contact.cta')} ↗
    </a>
  </section>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import ProjectModal from '../../../components/ProjectModal.astro';
import { projects } from '../../../data/projects';
import { useTranslations } from '../../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t('work.title')} — Darlyng Mateo`}
  description={t('work.description')}
>
  <section class="section container">
    <span class="eyebrow">{t('work.label')}</span>
    <h1 class="section-title" style="margin-top: 16px;">{t('work.title')}</h1>
    <p class="subtitle" style="margin-top: 12px;">{t('work.subtitle')}</p>
    <p class="lead" style="margin-top: 20px;">{t('work.description')}</p>

    <div class="project-list">
      {projects.map((p) => (
        <>
          <ProjectCard project={p} lang={lang} variant="full" />
          <ProjectModal project={p} lang={lang} />
        </>
      ))}
    </div>
  </section>
</BaseLayout>

---
import type { Certificate, Lang } from '../types';
import { formatDate } from '../data/certificates';
import { useTranslations } from '../i18n/utils';

interface Props {
  certificate: Certificate;
  lang: Lang;
}
const { certificate, lang } = Astro.props;
const t = useTranslations(lang);
const modalId = `cert-modal-${certificate.id}`;
---

<article class="cert-card" data-reveal>
  {/* Interactive Thumbnail Container — Zoom on hover & clicks to open expanded modal */}
  <div class="cert-thumb-wrapper">
    <button
      type="button"
      class="cert-thumb-trigger"
      data-modal-target={modalId}
      aria-haspopup="dialog"
      aria-label={`${t('certificates.preview')}: ${certificate.name[lang]}`}
    >
      <div class="cert-thumb-frame">
        {certificate.thumbnail && (
          <img
            src={certificate.thumbnail}
            alt={`${certificate.name[lang]} preview`}
            class="cert-thumb-img"
            loading="lazy"
            onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
          />
        )}
        {/* Editorial High-Fidelity SVG/CSS Credential Plate (Default / Fallback) */}
        <div class="cert-thumb-plate" style={certificate.thumbnail ? 'display: none;' : 'display: flex;'}>
          <div class="plate-pattern" aria-hidden="true"></div>
          <div class="plate-inner-border" aria-hidden="true"></div>
          <div class="plate-content">
            <div class="plate-top">
              <span class="plate-issuer-mono">{certificate.issuerShort}</span>
              <span class="plate-status-dot" aria-hidden="true"></span>
            </div>
            <div class="plate-center">
              <div class="plate-seal-icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <circle cx="12" cy="8" r="6" />
                  <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
                  <path d="m9 8 2 2 4-4" />
                </svg>
              </div>
              <p class="plate-cert-title">{certificate.name[lang]}</p>
              <p class="plate-recipient">Darlyng Mateo</p>
            </div>
            <div class="plate-bottom">
              <span class="plate-id">{certificate.credentialId || certificate.id}</span>
              <span class="plate-year">{certificate.issuedDate.slice(0, 4)}</span>
            </div>
          </div>
        </div>

        {/* Hover interactive overlay */}
        <div class="cert-thumb-overlay" aria-hidden="true">
          <span class="cert-thumb-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
              <line x1="11" y1="8" x2="11" y2="14" />
              <line x1="8" y1="11" x2="14" y2="11" />
            </svg>
            <span>{t('certificates.expand')}</span>
          </span>
        </div>
      </div>
    </button>
  </div>

  <div class="cert-body">
    <div class="cert-header-row">
      <span class="cert-label">{t('certificates.verified')}</span>
      {certificate.credentialId && (
        <span class="cert-credential-id">{certificate.credentialId}</span>
      )}
    </div>

    <h3 class="cert-title">{certificate.name[lang]}</h3>

    <dl class="cert-meta">
      <div>
        <dt>{t('certificates.issuer')}</dt>
        <dd>{certificate.issuer[lang]}</dd>
      </div>
      <div>
        <dt>{t('certificates.issued')}</dt>
        <dd>{formatDate(certificate.issuedDate, lang)}</dd>
      </div>
      {certificate.expiresDate && (
        <div>
          <dt>{t('certificates.expires')}</dt>
          <dd>{formatDate(certificate.expiresDate, lang)}</dd>
        </div>
      )}
      {certificate.score && (
        <div>
          <dt>{t('certificates.score')}</dt>
          <dd>{certificate.score}</dd>
        </div>
      )}
      {certificate.durationHours && (
        <div>
          <dt>{t('certificates.duration')}</dt>
          <dd>{certificate.durationHours} {t('certificates.hours')}</dd>
        </div>
      )}
    </dl>

    <div class="cert-actions">
      <a
        href={certificate.pdfPath}
        target="_blank"
        rel="noopener noreferrer"
        class="btn primary"
      >
        <span>{t('certificates.view')}</span>
        <span aria-hidden="true">↗</span>
      </a>
      {certificate.verificationUrl && (
        <a
          href={certificate.verificationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn"
        >
          <span>{t('certificates.verifyOnline')}</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
      <button
        type="button"
        class="btn"
        data-modal-target={modalId}
        aria-haspopup="dialog"
      >
        <span>{t('certificates.preview')}</span>
      </button>
    </div>
  </div>
</article>

{/* Expanded Modal Preview with iframe + direct actions */}
<div
  class="modal-overlay"
  id={modalId}
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-labelledby={`title-${modalId}`}
>
  <div class="modal cert-preview-modal">
    <div class="modal-header">
      <div>
        <span class="eyebrow">{certificate.issuerShort} · {certificate.credentialId || 'VERIFIED'}</span>
        <h3 class="modal-title" id={`title-${modalId}`}>{certificate.name[lang]}</h3>
      </div>
      <button
        type="button"
        class="icon-btn"
        data-modal-close
        aria-label={t('work.modal.close')}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
    <div class="cert-iframe-wrap">
      <iframe
        src={certificate.pdfPath}
        title={certificate.name[lang]}
        loading="lazy"
      ></iframe>
    </div>
    <div class="modal-actions" style="margin-top: 16px;">
      <a
        href={certificate.pdfPath}
        target="_blank"
        rel="noopener noreferrer"
        class="btn primary"
      >
        <span>{t('certificates.view')}</span>
        <span aria-hidden="true">↗</span>
      </a>
      <a
        href={certificate.pdfPath}
        download
        class="btn"
      >
        <span>{t('certificates.download')}</span>
      </a>
      {certificate.verificationUrl && (
        <a
          href={certificate.verificationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn"
        >
          <span>{t('certificates.verifyOnline')}</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
      <button type="button" class="btn" data-modal-close>
        <span>{t('work.modal.close')}</span>
      </button>
    </div>
  </div>
</div>

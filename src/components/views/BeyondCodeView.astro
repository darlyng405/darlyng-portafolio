---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, localizedPath } from '../../i18n/utils';
import type { Lang } from '../../types';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  title={t('meta.beyond.title')}
  description={t('meta.beyond.description')}
>
  <section class="section container">
    <div data-reveal>
      <span class="eyebrow">{t('beyond.label')}</span>
      <h1 class="section-title" style="margin-top: 16px; max-width: 24ch; text-wrap: balance;">
        {t('beyond.title')}
      </h1>
      <p class="lead" style="margin-top: 18px; font-size: clamp(16px, 1.4vw, 19px); color: var(--text);">
        {t('beyond.subtitle')}
      </p>
    </div>

    <div class="beyond-editorial-card" data-reveal>
      <span class="eyebrow">{t('beyond.status.label')}</span>
      <h2 class="project-title" style="margin-top: 12px;">{t('beyond.status.title')}</h2>
      <p class="lead" style="margin-top: 12px;">{t('beyond.status.body')}</p>

      <div class="beyond-pillars">
        <div class="beyond-pillar">
          <div class="beyond-pillar-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
            </svg>
          </div>
          <h3>{t('beyond.pillar1.title')}</h3>
          <p>{t('beyond.pillar1.desc')}</p>
        </div>

        <div class="beyond-pillar">
          <div class="beyond-pillar-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <circle cx="12" cy="12" r="10" />
              <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />
            </svg>
          </div>
          <h3>{t('beyond.pillar2.title')}</h3>
          <p>{t('beyond.pillar2.desc')}</p>
        </div>

        <div class="beyond-pillar">
          <div class="beyond-pillar-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
            </svg>
          </div>
          <h3>{t('beyond.pillar3.title')}</h3>
          <p>{t('beyond.pillar3.desc')}</p>
        </div>
      </div>

      <div class="btn-row" style="margin-top: 32px;">
        <a href={localizedPath('/about', lang)} class="btn primary">
          <span aria-hidden="true">←</span>
          <span>{t('beyond.backAbout')}</span>
        </a>
        <a href={localizedPath('/', lang)} class="btn">
          <span>{t('beyond.backHome')}</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

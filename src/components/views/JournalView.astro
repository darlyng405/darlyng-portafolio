---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, localizedPath } from '../../i18n/utils';
import type { Lang } from '../../types';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  title={t('meta.journal.title')}
  description={t('meta.journal.description')}
>
  <section class="section container">
    <div data-reveal>
      <span class="eyebrow">{t('journal.label')}</span>
      <h1 class="section-title" style="margin-top: 16px;">{t('journal.title')}</h1>
      <p class="subtitle" style="margin-top: 12px;">{t('journal.subtitle')}</p>
    </div>

    <div class="journal-empty-grid" data-reveal>
      <div class="empty-state">
        <div class="empty-state-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
            <polyline points="10 9 9 9 8 9" />
          </svg>
        </div>
        <h2>{t('journal.empty.title')}</h2>
        <p>{t('journal.empty.body')}</p>
        <div class="btn-row" style="margin-top: 24px;">
          <a href={localizedPath('/work', lang)} class="btn primary">
            <span>{t('hero.cta.projects')}</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <aside class="journal-blueprint-card">
        <span class="skill-group-label">{t('journal.upcoming.label')}</span>
        <ul class="blueprint-topic-list">
          <li>
            <span class="topic-num">01</span>
            <span>{t('journal.upcoming.t1')}</span>
          </li>
          <li>
            <span class="topic-num">02</span>
            <span>{t('journal.upcoming.t2')}</span>
          </li>
          <li>
            <span class="topic-num">03</span>
            <span>{t('journal.upcoming.t3')}</span>
          </li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

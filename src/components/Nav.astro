---
import { getLangFromUrl, useTranslations, alternatePath, localizedPath } from '../i18n/utils';
import type { UIKey } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

type Item = { path: string; key: UIKey };
const items: Item[] = [
  { path: '/', key: 'nav.home' },
  { path: '/work', key: 'nav.work' },
  { path: '/journal', key: 'nav.journal' },
  { path: '/about', key: 'nav.about' },
  { path: '/contact', key: 'nav.contact' },
];

const otherLang = lang === 'en' ? 'es' : 'en';
const switchHref = alternatePath(currentPath);
const isActive = (path: string) => {
  const full = localizedPath(path, lang);
  if (full === '/') return currentPath === '/' || currentPath === '/es/';
  if (full === '/es') return currentPath === '/es' || currentPath === '/es/';
  return currentPath === full || currentPath.startsWith(full + '/');
};
---

<header class="nav">
  <div class="container nav-inner">
    <a href={localizedPath('/', lang)} class="logo" aria-label="Darlyng Mateo — Home">
      D<span>.</span> MATEO
    </a>

    <nav class="nav-links" aria-label="Primary">
      {items.map((item) => (
        <a
          href={localizedPath(item.path, lang)}
          class="nav-link"
          aria-current={isActive(item.path) ? 'page' : undefined}
        >
          {t(item.key)}
        </a>
      ))}
    </nav>

    <div class="nav-controls">
      <a
        href={switchHref}
        class="lang-switch"
        data-set-lang={otherLang}
        aria-label={t('nav.switchLang')}
      >
        {otherLang === 'es' ? t('lang.es') : t('lang.en')}
      </a>
      <span class="nav-divider" aria-hidden="true"></span>
      <button
        id="theme-toggle"
        type="button"
        class="icon-btn"
        aria-label={t('nav.toggleTheme')}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
      <button
        id="mobile-menu-toggle"
        type="button"
        class="icon-btn menu-toggle"
        aria-label={t('nav.openMenu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" data-open="false">
    <ul>
      {items.map((item) => (
        <li>
          <a
            href={localizedPath(item.path, lang)}
            aria-current={isActive(item.path) ? 'page' : undefined}
          >
            {t(item.key)}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

---
import type { Project, Lang } from '../types';
import { useTranslations, localizedPath } from '../i18n/utils';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const statusKey = `work.status.${project.status}` as const;
const detailHref = localizedPath(`/work/${project.slug}`, lang);
const overviewSection = project.sections[0];
---

<div
  class="modal-overlay"
  id={`modal-${project.slug}`}
  data-open="false"
  role="dialog"
  aria-modal="true"
  aria-labelledby={`modal-title-${project.slug}`}
>
  <div class="modal">
    <div class="modal-header">
      <div>
        <span class="eyebrow" style="margin-bottom: 6px;">{t(statusKey)}</span>
        <h3 class="modal-title" id={`modal-title-${project.slug}`}>{project.title}</h3>
        <p class="modal-subtitle">{project.category[lang]}</p>
      </div>
      <button
        type="button"
        class="icon-btn"
        data-modal-close
        aria-label={t('work.modal.close')}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <div class="modal-body">
      <p>{overviewSection?.body ? overviewSection.body[lang] : project.description[lang]}</p>

      {project.tech.length > 0 && (
        <div class="modal-tech-block">
          <span class="modal-block-label">{t('work.modal.tech')}</span>
          <div class="project-tech-inline" style="margin-top: 8px;">
            {project.tech.map((tag, i) => (
              <>
                {i > 0 && <span class="sep" aria-hidden="true">·</span>}
                <span class="tech-item">{tag}</span>
              </>
            ))}
          </div>
        </div>
      )}

      <div class="modal-actions">
        <a href={detailHref} class="btn primary">
          <span>{t('work.cta.full')}</span>
          <span aria-hidden="true">↗</span>
        </a>
        <button type="button" class="btn" data-modal-close>
          <span>{t('work.modal.close')}</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let activeTrigger: HTMLElement | null = null;

  document.querySelectorAll<HTMLButtonElement>('[data-modal-target]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.modalTarget;
      if (!id) return;
      const overlay = document.getElementById(id);
      if (!overlay) return;
      activeTrigger = btn;
      overlay.setAttribute('data-open', 'true');
      document.body.style.overflow = 'hidden';
      const closeBtn = overlay.querySelector<HTMLButtonElement>('[data-modal-close]');
      closeBtn?.focus();
    });
  });

  document.querySelectorAll<HTMLElement>('.modal-overlay').forEach((overlay) => {
    const close = () => {
      overlay.setAttribute('data-open', 'false');
      document.body.style.overflow = '';
      activeTrigger?.focus();
    };
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });
    overlay.querySelectorAll<HTMLElement>('[data-modal-close]').forEach((b) => {
      b.addEventListener('click', close);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay.getAttribute('data-open') === 'true') close();
    });
  });
</script>

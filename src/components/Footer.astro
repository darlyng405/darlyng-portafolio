---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';
import { site } from '../data/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <span>{t('footer.copyright').replace('{year}', String(year))}</span>
    <nav class="footer-links" aria-label="Footer">
      <a href={localizedPath('/work', lang)}>{t('nav.work')}</a>
      <a href={localizedPath('/about', lang)}>{t('nav.about')}</a>
      <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
    <span>{t('footer.tagline')} ↗</span>
  </div>
</footer>

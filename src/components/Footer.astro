---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';
import { site } from '../data/site';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="footer-name">{site.name}</span>
      <span class="sep" aria-hidden="true">·</span>
      <span>{t('footer.copyright').replace('{year}', String(year))}</span>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      <a href={localizedPath('/', lang)}>{t('nav.home')}</a>
      <a href={localizedPath('/work', lang)}>{t('nav.work')}</a>
      <a href={localizedPath('/journal', lang)}>{t('nav.journal')}</a>
      <a href={localizedPath('/about', lang)}>{t('nav.about')}</a>
      <a href={localizedPath('/certificates', lang)}>{t('nav.certificates')}</a>
      <a href={localizedPath('/beyond-code', lang)}>{t('nav.beyond')}</a>
      <a href={localizedPath('/contact', lang)}>{t('nav.contact')}</a>
    </nav>

    <div class="footer-social">
      <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
    </div>
  </div>
</footer>

---
import type { Lang } from '../types';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const interests = [
  {
    id: 'algorithms',
    index: '01',
    title: t('home.interests.algorithms'),
    desc: t('home.interests.algorithms.desc'),
    notation: 'O(N log N) · Graph & DP',
  },
  {
    id: 'backend',
    index: '02',
    title: t('home.interests.backend'),
    desc: t('home.interests.backend.desc'),
    notation: 'REST · SQL · Auth',
  },
  {
    id: 'distributed',
    index: '03',
    title: t('home.interests.distributed'),
    desc: t('home.interests.distributed.desc'),
    notation: 'Nodes · State · Sync',
  },
  {
    id: 'os',
    index: '04',
    title: t('home.interests.os'),
    desc: t('home.interests.os.desc'),
    notation: 'Threads · Memory · I/O',
  },
];
---

<ul class="interest-grid">
  {interests.map((item) => (
    <li class="interest-card" data-reveal>
      <div class="interest-card-top">
        <span class="interest-index">{item.index}</span>
        <div class="interest-diagram" aria-hidden="true">
          {item.id === 'algorithms' && (
            <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
              <line x1="22" y1="10" x2="12" y2="24" stroke="currentColor" stroke-width="1.4" stroke-opacity="0.45" />
              <line x1="22" y1="10" x2="32" y2="24" stroke="currentColor" stroke-width="1.4" stroke-opacity="0.45" />
              <line x1="12" y1="24" x2="7" y2="35" stroke="currentColor" stroke-width="1.4" stroke-opacity="0.45" />
              <line x1="12" y1="24" x2="17" y2="35" stroke="currentColor" stroke-width="1.4" stroke-opacity="0.45" />
              <line x1="32" y1="24" x2="36" y2="35" stroke="currentColor" stroke-width="1.4" stroke-opacity="0.45" />
              <circle cx="22" cy="10" r="3.5" class="svg-accent-fill" />
              <circle cx="12" cy="24" r="3" stroke="currentColor" stroke-width="1.5" fill="var(--surface)" />
              <circle cx="32" cy="24" r="3" class="svg-blue-fill" />
              <circle cx="7" cy="35" r="2.5" stroke="currentColor" stroke-width="1.4" fill="var(--surface)" />
              <circle cx="17" cy="35" r="2.5" class="svg-accent-fill" />
              <circle cx="36" cy="35" r="2.5" stroke="currentColor" stroke-width="1.4" fill="var(--surface)" />
            </svg>
          )}
          {item.id === 'backend' && (
            <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
              <rect x="6" y="8" width="32" height="8" rx="2" stroke="currentColor" stroke-width="1.4" />
              <circle cx="11" cy="12" r="1.5" class="svg-accent-fill" />
              <line x1="16" y1="12" x2="32" y2="12" stroke="currentColor" stroke-width="1.2" stroke-opacity="0.5" />
              <rect x="6" y="19" width="32" height="8" rx="2" stroke="currentColor" stroke-width="1.4" />
              <circle cx="11" cy="23" r="1.5" class="svg-blue-fill" />
              <line x1="16" y1="23" x2="28" y2="23" stroke="currentColor" stroke-width="1.2" stroke-opacity="0.5" />
              <path d="M12 31v4c0 1.66 4.48 3 10 3s10-1.34 10-3v-4" stroke="currentColor" stroke-width="1.4" />
              <ellipse cx="22" cy="31" rx="10" ry="2.5" stroke="currentColor" stroke-width="1.4" />
            </svg>
          )}
          {item.id === 'distributed' && (
            <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
              <polygon points="22,7 36,15 36,29 22,37 8,29 8,15" stroke="currentColor" stroke-width="1.2" stroke-dasharray="2 2" stroke-opacity="0.5" />
              <line x1="22" y1="7" x2="22" y2="22" stroke="currentColor" stroke-width="1.3" stroke-opacity="0.6" />
              <line x1="36" y1="15" x2="22" y2="22" stroke="currentColor" stroke-width="1.3" stroke-opacity="0.6" />
              <line x1="8" y1="29" x2="22" y2="22" stroke="currentColor" stroke-width="1.3" stroke-opacity="0.6" />
              <line x1="36" y1="29" x2="22" y2="22" stroke="currentColor" stroke-width="1.3" stroke-opacity="0.6" />
              <circle cx="22" cy="22" r="4" class="svg-accent-fill" />
              <circle cx="22" cy="7" r="2.5" class="svg-blue-fill" />
              <circle cx="36" cy="15" r="2.5" stroke="currentColor" stroke-width="1.4" fill="var(--surface)" />
              <circle cx="36" cy="29" r="2.5" class="svg-blue-fill" />
              <circle cx="22" cy="37" r="2.5" stroke="currentColor" stroke-width="1.4" fill="var(--surface)" />
              <circle cx="8" cy="29" r="2.5" class="svg-blue-fill" />
              <circle cx="8" cy="15" r="2.5" stroke="currentColor" stroke-width="1.4" fill="var(--surface)" />
            </svg>
          )}
          {item.id === 'os' && (
            <svg width="44" height="44" viewBox="0 0 44 44" fill="none">
              <rect x="12" y="12" width="20" height="20" rx="2.5" stroke="currentColor" stroke-width="1.5" />
              <rect x="17" y="17" width="10" height="10" rx="1" class="svg-accent-stroke" stroke-width="1.5" />
              <line x1="17" y1="7" x2="17" y2="12" stroke="currentColor" stroke-width="1.4" />
              <line x1="22" y1="7" x2="22" y2="12" stroke="currentColor" stroke-width="1.4" />
              <line x1="27" y1="7" x2="27" y2="12" stroke="currentColor" stroke-width="1.4" />
              <line x1="17" y1="32" x2="17" y2="37" stroke="currentColor" stroke-width="1.4" />
              <line x1="22" y1="32" x2="22" y2="37" stroke="currentColor" stroke-width="1.4" />
              <line x1="27" y1="32" x2="27" y2="37" stroke="currentColor" stroke-width="1.4" />
              <line x1="7" y1="17" x2="12" y2="17" stroke="currentColor" stroke-width="1.4" />
              <line x1="7" y1="22" x2="12" y2="22" stroke="currentColor" stroke-width="1.4" />
              <line x1="7" y1="27" x2="12" y2="27" stroke="currentColor" stroke-width="1.4" />
              <line x1="32" y1="17" x2="37" y2="17" stroke="currentColor" stroke-width="1.4" />
              <line x1="32" y1="22" x2="37" y2="22" stroke="currentColor" stroke-width="1.4" />
              <line x1="32" y1="27" x2="37" y2="27" stroke="currentColor" stroke-width="1.4" />
            </svg>
          )}
        </div>
      </div>
      <h3 class="interest-title">{item.title}</h3>
      <p class="interest-desc">{item.desc}</p>
      <span class="interest-notation">{item.notation}</span>
    </li>
  ))}
</ul>

---
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';
import CodeCard from './CodeCard.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero container">
  <div class="hero-text">
    <span class="eyebrow" data-stagger>{t('hero.kicker')}</span>
    <h1 class="display" data-stagger style="margin-top: 20px;">
      {t('hero.headline1')}<br />
      <em>{t('hero.headline2')}</em><br />
      {t('hero.headline3')}
    </h1>
    <p class="lead" data-stagger style="margin-top: 22px;">{t('hero.description')}</p>
    <div class="hero-ctas" data-stagger>
      <a href={localizedPath('/work', lang)} class="btn primary">
        <span>{t('hero.cta.projects')}</span>
        <span aria-hidden="true">↗</span>
      </a>
      <a href={localizedPath('/journal', lang)} class="btn">
        <span>{t('hero.cta.journal')}</span>
      </a>
    </div>
  </div>

  <div class="hero-card" data-reveal>
    <CodeCard />
  </div>
</section>
